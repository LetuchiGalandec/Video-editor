# Copy to .env.prod on the server and fill in. Never commit the real file.
#
#   cp .env.prod.example .env.prod && nano .env.prod

# --- Public hostname (required) -------------------------------------------
# The domain whose A record points at this machine's public IP. Caddy requests
# a Let's Encrypt certificate for exactly this name, so it must resolve here
# before you start the stack.
CROPCORN_DOMAIN=clips.example.com
# Let's Encrypt sends expiry warnings here.
CROPCORN_TLS_EMAIL=you@example.com

# --- Google OAuth ----------------------------------------------------------
# Required only for "Save to YouTube". Leave blank to run without it.
# The redirect URI is derived from CROPCORN_DOMAIN by docker-compose.prod.yml;
# register that exact HTTPS URL in the Google Cloud console:
#   https://<CROPCORN_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Session ---------------------------------------------------------------
# MUST be set to a long random value in production; the built-in default is a
# known constant, so leaving it unset lets anyone forge a session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# --- Limits ----------------------------------------------------------------
# Tighter than local defaults: this box is shared with everyone you send the
# link to, and re-encoding is CPU-bound.
# Longest fetchable video (seconds). 1h instead of the 4h default.
MAX_DURATION_SEC=3600
# Max upload size in bytes. 500 MB instead of the 2 GB default.
MAX_UPLOAD_BYTES=524288000
# Longest uploaded video (seconds).
MAX_UPLOAD_DURATION_SEC=3600
# Minutes before fetched videos and clips are swept from disk.
TTL_MINUTES=180
# Cap fetch quality. 720p is ~5x smaller than 1080p and much faster to encode.
YT_MAX_HEIGHT=720

# --- Features --------------------------------------------------------------
# Set to false for an upload-only public build (hides and disables YouTube
# fetching). Worth considering: from a datacenter IP, YouTube frequently
# refuses yt-dlp with a bot check, so the fetch path is unreliable in the cloud
# while uploads always work.
YOUTUBE_ENABLED=true

# --- Cookies (optional) ----------------------------------------------------
# Mounting your exported YouTube cookies makes fetching far more reliable from
# a datacenter IP, but every visitor's download then runs as your Google
# account, which risks it being rate-limited or flagged. Left unset by default.
# YT_COOKIES_FILE=/data/cookies.txt
