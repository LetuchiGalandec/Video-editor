# syntax=docker/dockerfile:1

# --- Build stage: compile the Angular app ---
FROM node:22 AS build
WORKDIR /app
# Every workspace package.json must be present before `npm ci`, or the install
# fails on the workspace declarations in the root package.json.
COPY package*.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY e2e/package.json e2e/
RUN npm ci
COPY . .
RUN npm run build -w web

# --- Runtime stage: nginx serves the static bundle and proxies /api ---
FROM nginx:1.27-alpine AS runtime
# @angular/build:application emits the browser bundle under dist/<project>/browser.
COPY --from=build /app/apps/web/dist/web/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
