# Copy to .env and fill in. All values optional except the Google pair for uploads.

# Server port (the Angular dev proxy expects 3000)
PORT=3000

# Where fetched videos, clips and OAuth tokens live (default: apps/server/.data)
# DATA_DIR=

# 'ytdlp' (real fetches) or 'fake' (copies fixtures/sample.mp4 — used by e2e)
# FETCHER=ytdlp

# Longest fetchable video, in seconds (default 14400 = 4h)
# MAX_DURATION_SEC=14400

# Minutes before fetched videos/clips are swept from disk (default 360 = 6h)
# TTL_MINUTES=360

# Google OAuth for "Save to YouTube (Private)" — see README for the
# 5-minute Google Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# WEB_ORIGIN=http://localhost:4200

# Override the bundled binaries if you prefer system installs
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=
