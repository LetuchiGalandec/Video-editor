# Copy to .env and fill in. All values optional except the Google pair for uploads.

# Server port (the Angular dev proxy expects 3000)
PORT=3000

# Where fetched videos, clips and OAuth tokens live (default: apps/server/.data)
# DATA_DIR=

# 'ytdlp' (real fetches) or 'fake' (copies fixtures/sample.mp4 — used by e2e)
# FETCHER=ytdlp

# Longest fetchable video, in seconds (default 14400 = 4h)
# MAX_DURATION_SEC=14400

# Minutes before fetched videos/clips are swept from disk (default 360 = 6h)
# TTL_MINUTES=360

# Max video height to fetch (default 1080). Set 720 for much smaller/faster
# downloads — a 10-min 1080p video is ~450 MB vs ~90 MB at 720p.
# YT_MAX_HEIGHT=1080

# Google OAuth for "Save to YouTube (Private)" — see README for the
# 5-minute Google Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# WEB_ORIGIN=http://localhost:4200

# Secret used to sign the per-user session cookie. Any random string; change it
# to invalidate all existing sign-ins. A default is used if unset (fine locally).
# SESSION_SECRET=

# Cookies — let yt-dlp authenticate as your signed-in YouTube account so it can
# fetch age-restricted (and other login-gated) videos. Pick ONE:
#   1. Read cookies straight from your browser (easiest). Values: chrome, safari,
#      firefox, edge, brave, chromium, opera, vivaldi. Add a profile if needed,
#      e.g. "chrome:Default". Quit the browser first so its cookie DB isn't locked.
# YT_COOKIES_FROM_BROWSER=chrome
#   2. Or point at an exported Netscape-format cookies.txt.
# YT_COOKIES_FILE=/absolute/path/to/cookies.txt

# Override the bundled binaries if you prefer system installs
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=
